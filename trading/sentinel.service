[Unit]
Description=Niam-Bay Sentinel — 24/7 trading watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/usr/bin/python3 /home/ubuntu/niam-bay/trading/sentinel.py
Restart=always
RestartSec=30
StandardOutput=null
StandardError=journal

# Graceful shutdown
KillSignal=SIGTERM
TimeoutStopSec=15

# Environment
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
